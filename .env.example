# Copiar a .env y completar. El .env y el contenido de Wallet_* estan en .gitignore.
# El alias TNS es el nombre que aparece en Wallet_*/tnsnames.ora (por ejemplo tg243br3udtanbr0_tp).

# Docker Compose (wallet montado en /app/wallet):
DB_URL=jdbc:oracle:thin:@TU_TNS_ALIAS_tp?TNS_ADMIN=/app/wallet
# Local con ./mvnw spring-boot:run (ruta real al wallet), por ejemplo:
# DB_URL=jdbc:oracle:thin:@TU_TNS_ALIAS_tp?TNS_ADMIN=${user.home}/oracle_wallets/library

DB_USERNAME=
DB_PASSWORD=

# Debe coincidir con jwt.secret de ms-usuarios (escrituras locales)
JWT_SECRET=ForoJwtSecretKey2026DuocFullstackIIIExp1Semana2Segura
JWT_EXPIRATION_MS=86400000
